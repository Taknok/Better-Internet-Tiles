    <string name="read_phone_state">휴대폰 상태 읽기</string>
    <string name="read_phone_state_description">모바일 데이터 연결 정보를 읽으려면 \'휴대폰 상태 읽기\' 권한이 필요합니다.</string>
    <string name="bluetooth_connect">블루투스 연결</string>
