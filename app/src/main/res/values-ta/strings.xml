    <string name="good_to_go">எல்லாம் தயார்!</string>
    <string name="good_to_go_description">தேவையான அனைத்து அனுமதிகளும் வழங்கப்பட்டுள்ளன. கீழே கிடைக்கும் ஓடுகளைப் பாருங்கள்!</string>

    <string name="missing_permissions">தேவையான அனுமதிகள் இல்லை</string>
    <string name="missing_permissions_description">சில விஷயங்கள் எதிர்பார்த்தபடி செயல்படாமல் போகலாம். மேலும் தகவலுக்கு விரிவாக்கவும்.</string>
    <string name="shell_access">ஷெல் அணுகல்</string>
    <string name="shell_access_description">சில கணினி அம்சங்களை இயக்க அல்லது முடக்க ஷெல் அணுகல் தேவை. இதற்கு ரூட் அல்லது Shevery இரண்டில் ஒன்றைப் பயன்படுத்தலாம்.</string>
    <string name="read_phone_state">தொலைபேசி நிலையைப் படித்தல்</string>
    <string name="read_phone_state_description">மொபைல் தரவு இணைப்புத் தகவலைப் படிக்க \'தொலைபேசி நிலையைப் படித்தல்\' அனுமதி தேவை.</string>
    <string name="bluetooth_connect">புளூடூத் இணைப்பு</string>
    <string name="bluetooth_connect_description">இணைக்கப்பட்ட புளூடூத் சாதனத்தின் பெயரைப் படிக்க \'புளூடூத் இணைப்பு\' அனுமதி தேவை.</string>
